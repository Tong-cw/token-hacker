# Environment Variables for Token Hacker
# Copy this to .env.local and fill in your values

# === Required for Production ===

# Stripe payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# SiliconFlow (DeepSeek/Qwen/GLM upstream provider)
DEEPSEEK_API_KEY=sk-...
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Other upstream API providers (optional)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Session encryption
SESSION_SECRET=<generate with: openssl rand -base64 32>

# === Optional ===

# Custom domain
NEXT_PUBLIC_BASE_URL=https://www.aiapisave.xyz

# Database (for production — replace in-memory store)
# DATABASE_URL=postgres://...
